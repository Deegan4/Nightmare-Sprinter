{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "@cloudflare/workers-types", "node"],
    "isolatedModules": true
  },
  "include": ["src", "shared", "worker", "tests/**/*.ts", "vite.config.ts"]
}
